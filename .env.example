# env -------------------------------------

# 기본이미지 (이미지 없을 때)
NEXT_PUBLIC_BASIC_NO_IMAGE=https://ehfqntuqntu.cdn1.cafe24.com/common/no-image.png
# JWT 키
JWT_SECRET=
REFRESH_SECRET=
# 판매자 jwt 키
SELLER_JWT_SECRET=
# 관리자 jwt 키
ADMIN_JWT_SECRET=
# 휴대폰 인증 키
PHONE_AUTH=
# 휴대폰 인증 성공 키
PHONE_AUTH_COMPLETE=
# 비번 변경 키
PWD_CHANGE=
# 쿠키 보안 설정 (on: secure, off: secure 아님)
COOKIE_SECURE=on

WRONG_REQUEST_MESSAGE=잘 못 된 요청입니다.
# middleware accessToken 재발급 (true | false, 기본 false)
MIDDLEWARE_TOKEN_REFRESH_ENABLED=false
# middleware → 내부 refresh API 호출 시크릿 (미설정 시 JWT_SECRET 사용)
# INTERNAL_REFRESH_SECRET=
# 마일리지 적립률 (예: 0.01은 1% 적립)
MILEAGE_RATE=0.01


# env.development, env.production -------------------------------------

# nextjsAPI 안쓰고 다른 api로 바로 쏠꺼면 작성하기 / BFF만 쓰면 ''로 둬도 OK
NEXT_PUBLIC_BASE_URL=
SERVER_URL=
NEXT_PUBLIC_UPLOAD_BASE_URL=http://localhost:9377